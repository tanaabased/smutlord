{
  "agents": {
    "entries": {
      "smutlord": {
        "models": {
          "openai/gpt-6-luna": {
            "agentRuntime": {
              "id": "codex"
            }
          },
          "openai/gpt-6.1-sol": {
            "agentRuntime": {
              "id": "codex"
            }
          }
        },
        "modelPolicy": {
          "allow": ["openai/gpt-6.1-sol", "openai/gpt-6-luna"]
        },
        "tools": {
          "profile": "coding",
          "exec": {
            "mode": "auto"
          }
        },
        "memory": {
          "search": {
            "rememberAcrossConversations": true,
            "sources": ["memory", "sessions"],
            "experimental": {
              "sessionMemory": true
            },
            "store": {
              "vector": {
                "enabled": true
              }
            }
          }
        }
      }
    }
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": {
          "enabled": false
        }
      }
    }
  },
  "skills": {
    "workshop": {
      "autonomous": {
        "mode": "propose"
      }
    }
  }
}
